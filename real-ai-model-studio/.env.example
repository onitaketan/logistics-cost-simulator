# --- API ---
APP_ENV=local
API_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REQUIRE_2FA=false
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://rams:rams@localhost:5432/rams

# --- Queue / Async generation ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# true: 生成タスクをインライン実行（Redis不要・開発/テスト向け）。本番は false + worker 起動。
CELERY_TASK_ALWAYS_EAGER=true

# --- Storage (S3 / R2 compatible) ---
STORAGE_PROVIDER=local            # local | s3 | r2
STORAGE_BUCKET=rams-private
STORAGE_DIR=./storage             # local backend root (dev only; do not use for real PII)
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1          # S3/R2 region (read directly from env by the storage backend)
STORAGE_SSE=                      # optional server-side-encryption, e.g. AES256 (S3 only)
SIGNED_URL_TTL_SECONDS=120        # 生画像は短命署名URLのみ

# --- AI engine ---
AI_ENGINE=mock                    # mock | openai | replicate | self_hosted
AI_ENGINE_API_KEY=                # generic key; OpenAI/Replicate also accept the vars below
OPENAI_API_KEY=                   # used by the openai adapter (falls back to AI_ENGINE_API_KEY)
OPENAI_BASE_URL=                  # optional override, e.g. an Azure/proxy endpoint
REPLICATE_API_TOKEN=              # used by the replicate adapter

# --- Container bootstrap (docker-compose entrypoint) ---
# true (api service): apply migrations + seed on boot. false (worker): wait only.
RUN_MIGRATIONS=true

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
